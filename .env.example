# Copy to .env and fill in your values. Do not paste secrets into chat.

# Existing gtonic/nfl_mcp server. Start it separately; this analyst preserves it.
NFL_MCP_URL=http://localhost:9000/mcp

# Sleeper draft configuration.
SLEEPER_DRAFT_ID=
MY_DRAFT_SLOT=

# Optional if you want the app to discover drafts by username/league.
SLEEPER_USERNAME=
SLEEPER_LEAGUE_ID=

# Abacus RouteLLM, per official docs:
# self-serve base URL: https://routellm.abacus.ai/v1
# enterprise base URL: https://<workspace>.abacus.ai/v1
ABACUS_API_KEY=
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_MODEL=route-llm

# Ollama fallback. Keep this small on Apple Silicon M4/24GB.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Optional. If configured in nfl_mcp, Vegas lines can be included by MCP tools.
ENABLE_VEGAS=false

# Local web UI/API.
ANALYST_HOST=127.0.0.1
ANALYST_PORT=8787
